{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(pribeh|druzina|svedectvi|bitvy|mapa|proroctvi|osa|lexikon|u-stolu|dokument|podekovani)",
      "destination": "/index.html"
    },
    {
      "source": "/(pribeh|druzina|svedectvi|bitvy|mapa|proroctvi|lexikon)/:rest*",
      "destination": "/index.html"
    },
    {
      "source": "/hymna",
      "destination": "/index.html"
    }
  ]
}
