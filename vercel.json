{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/pribeh",
      "destination": "/pribeh/index.html"
    },
    {
      "source": "/druzina",
      "destination": "/druzina/index.html"
    },
    {
      "source": "/svedectvi",
      "destination": "/svedectvi/index.html"
    },
    {
      "source": "/bitvy",
      "destination": "/bitvy/index.html"
    },
    {
      "source": "/mapa",
      "destination": "/mapa/index.html"
    },
    {
      "source": "/proroctvi",
      "destination": "/proroctvi/index.html"
    },
    {
      "source": "/osa",
      "destination": "/osa/index.html"
    },
    {
      "source": "/lexikon",
      "destination": "/lexikon/index.html"
    },
    {
      "source": "/u-stolu",
      "destination": "/u-stolu/index.html"
    },
    {
      "source": "/hymna",
      "destination": "/hymna/index.html"
    },
    {
      "source": "/dokument",
      "destination": "/dokument/index.html"
    },
    {
      "source": "/podekovani",
      "destination": "/podekovani/index.html"
    },
    {
      "source": "/pribeh/kniha-1",
      "destination": "/pribeh/kniha-1/index.html"
    },
    {
      "source": "/pribeh/kniha-2",
      "destination": "/pribeh/kniha-2/index.html"
    },
    {
      "source": "/pribeh/kniha-3",
      "destination": "/pribeh/kniha-3/index.html"
    },
    {
      "source": "/pribeh/kniha-4",
      "destination": "/pribeh/kniha-4/index.html"
    },
    {
      "source": "/pribeh/kniha-5",
      "destination": "/pribeh/kniha-5/index.html"
    },
    {
      "source": "/(pribeh|druzina|svedectvi|bitvy|mapa|proroctvi|osa|lexikon|u-stolu|dokument|podekovani)",
      "destination": "/index.html"
    },
    {
      "source": "/(pribeh|druzina|svedectvi|bitvy|mapa|proroctvi|lexikon)/:rest*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/:file([^/]+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(pribeh|druzina|svedectvi|bitvy|mapa|proroctvi|osa|lexikon|u-stolu|hymna|dokument|podekovani)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}