[{"key":"I","kap":"Kniha první","title":"První tažení","real":"2003–2011","dr":"1372–1377 DR","sessions":30,"summary":"Družina se dala dohromady v Tethyru, pomohla královně Finian sesadit jejího bratrance barona Althaluse z Castle Tethyr a stala se Tethyrskou královskou družinou. V Ithmongu padl mnich Veritas rukou stříbrného mága Thalaxie Raslemtara a po pirátské mezihře v Nelantheru přišel z kláštera Subotami východňan Ho. Velká výprava do Kara-Turu vedla přes Kozakuru a pád Šivana do Shou Lungu, kde družina pomohla na trůn císařovně Zako a střetla se s upírem Joldem i s tuiganským chánem. Po návratu si družina začala říkat Štíty Apokalypsy, prošla Sigil a sféry, přeplula do Maztiky, na Severu lovila jména ze seznamu „20 to dead“ a sestoupila do podmořského světa. Tažení vyvrcholilo masakrem tethyrského hlavního města, cestou k bohu času Chronosovi a Bitvou o Tvář vědění proti Zesion. Ho se bitvy jako jediný nezúčastnil, Varion se ztratil v Šedých pláních.","key_places":["Castle Tethyr","Ithmong","Nelanther","Klášter Subotami","Kozakura","Shou Lung","Tuigan","Sigil","Maztica","Stříbroluní","Sothasil","Tvář vědění"],"key_enemies":["baron Althalus","Thalaxia Stříbrný Raslemtar","Nagwanaya","Šivan","upír Joldo z 15. domu","chán Yamun a šaman Yamoh Hokhra","Hieronimus Lex","Toacoatl a biskup Domincus","Lurna","Zesion"],"img":"D_02","side":[{"key":"klid","title":"Pět let klidu","summary":"Po Bitvě o Tvář vědění šel každý svou cestou a Pán jeskyně hrál osudy postav s každým hráčem zvlášť. Ho se místo bitvy ocitl ve sférické citadele Feng Asay, Žaláři bohů, kde porazil Yamuna II. a kde padl jeho učitel Kung Lao. Skoro tři roky pak strávil u Šedých mnichů v horské pevnosti Tempat Larang, vyřídil své záležitosti v hlavním městě Shou Lungu a na západě znovu zprovoznil Chrám Západního úsvitu, kam za ním na sklonku roku 1380 DR dorazila Seung Mina. Rauko převzal západní kapitulu Tempových bitevních mágů a Alwarinovu univerzitu, Varion spravoval Dračí let a Austius zdědil otcovy ostrostřelce. Klid skončil s rokem 1382 DR, kdy se v Rashemenu odmlčela druhá polovina bitevních mágů a na obloze se objevila nová hvězda.","real":"2011–2012","dr":"1377–1382 DR"}],"chapters":[{"title":"Z Tethyru na Východ","sessions":["s-2003","s-2003-b","s-2004","s-2005","s-2005-11-18","s-2005-12","s-2006","s-2006-02"],"real":"2003–2006","drs":"1372–1374 DR","id":"ch-z-tethyru-na-vychod","words":593,"min":3,"route":[0,1,2,3,4,5,6],"cast":[["Veritas","Pepa"],["Rauko","Lukáš"],["Nathan","Pepa"],["Ho","Pepa"],["Varion","Zdeněk K."],["Sirion","Vojta"]],"gallery":[{"k":"ilu/K_001","cap":"Družina sesazuje barona Althaluse z Castle Tethyr.","s":"s-2003"},{"k":"ilu/K_002","cap":"Rada kapitánů ve Skaugu na pirátských ostrovech Nelantheru.","s":"s-2004"},{"k":"nove/n80","cap":"Pirát Nathan na palubě v bouři.","s":"s-2004"},{"k":"ilu/K_003","cap":"Po pádu Šivana: Varion hrdinou Kozakury, Ho s tváří, která se už neusměje.","s":"s-2005-12"},{"k":"ilu/K_004","cap":"Zako usedá na dračí trůn Shou Lungu.","s":"s-2006"}],"regions":["Tethyr","Moře mečů","Kara-Tur","Jiné"],"players":["Pepa","Lukáš","Zdeněk K.","Vojta"]},{"title":"Shou Lung a velké tažení","sessions":["s-2006-03-17","s-2006-04"],"real":"2006","drs":"1374 DR","id":"ch-shou-lung-a-velke-tazeni","words":367,"min":2,"route":[7,8,9,10,11,12,13,14,15],"cast":[["Ho","Pepa"],["Rauko","Lukáš"],["Varion","Zdeněk K."],["Sirion","Vojta"]],"gallery":[],"regions":["Kara-Tur"],"players":["Pepa","Lukáš","Zdeněk K.","Vojta"]},{"title":"Návrat, Tyrův chrám a Sigil","sessions":["s-2006-12","s-2007","s-2007-02-03","s-2007-02-09","s-2007-03-31","s-2007-04"],"real":"2006–2007","drs":"1375–1376 DR","id":"ch-navrat-tyruv-chram-a-sigil","words":368,"min":2,"route":[16,17,18,19,20,21,22],"cast":[["Ho","Pepa"],["Rauko","Lukáš"],["Varion","Zdeněk K."],["Sirion","Vojta"],["Austius","Vojta"],["Calla","Jana"]],"gallery":[{"k":"ilu/K_006","cap":"Bílý racek doplouvá přes oceán k břehům Maztiky.","s":"s-2007"},{"k":"ilu/K_005","cap":"Rauko se v Sigilu učí u mistra čepele tvarované myslí.","s":"s-2007-04"}],"regions":["Tethyr","Maztica","Sigil a sféry"],"players":["Pepa","Lukáš","Zdeněk K.","Vojta","Jana"]},{"title":"Štíty Apokalypsy","sessions":["s-2007-06-29","s-2007-07-06","s-2007-07-25","s-2007-08-26","s-2008","s-2009","s-2010"],"real":"2007–2010","drs":"1375–1377 DR","id":"ch-stity-apokalypsy","words":404,"min":2,"route":[23,24,25,26,27,28,29],"cast":[["Ho","Pepa"],["Rauko","Lukáš"],["Varion","Zdeněk K."],["Sirion","Vojta"],["Calla","Jana"],["Austius","Vojta"]],"gallery":[{"k":"ilu/K_007","cap":"Na severu družina s lovci z kmene Losa stopuje klan Cron.","s":"s-2008"},{"k":"ilu/K_008","cap":"Korálové město Sothasil pod hladinou.","s":"s-2009"},{"k":"ilu/K_009","cap":"Lathander odvádí družinu z hořícího hlavního města k Chronosovi.","s":"s-2010"}],"regions":["Tethyr","Údolí a Cormanthor","Sever a Stříbrné pochody","Moře mečů"],"players":["Pepa","Lukáš","Zdeněk K.","Vojta","Jana"]},{"title":"Feng Asay a Tempat Larang","sessions":["s-2011-06-21","s-2011-07-14","s-2011-08-15","s-2011-08-25","s-2011-12-05","s-2011-12-18","s-2011-12-21"],"real":"2011","drs":"1377–1382 DR","id":"ch-feng-asay-a-tempat-larang","words":441,"min":3,"route":[30,31,32],"cast":[["Ho","Pepa"]],"gallery":[{"k":"ilu/K_010","cap":"Ho přichází do horské pevnosti Tempat Larang.","s":"s-2011-08-15"}],"regions":["Sigil a sféry","Kara-Tur"],"players":["Pepa"]}]},{"key":"II","kap":"Kniha druhá","title":"Rudá pevnost a návraty","real":"prosinec 2011–2015","dr":"1383 DR","sessions":48,"summary":"Na oslavě Nového roku 1383 DR se družina po pěti letech sešla na Dračím letu, kde ztroskotala kovová loď z jiného času plná yugolothů a drowští zabijáci z Genoaardu umlčeli posledního svědka. Královninou létající lodí družina odletěla na sever do Pevnosti Rudé rytířky, na kterou táhlo přes 120 tisíc skřetů, a dozvěděla se, že nová hvězda je město Temných Netherilců. V knihovně Arenkae porazila adamantiové golemy, ale knihovnici Alanu en Nausef unesli Axel Adamantis, Devrel a lebkoun Sar Saratar. V Bitvě o Rudou pevnost, hrané podle vlastního bitevního systému, byla Horda odražena, ale ztráty byly příliš velké: padla Rudá rytířka a družina v bitvě ztratila Variona. Následoval návrat do Tethyru, obrana vlastních držav, quest s mythalem a elfí královnou, přestupy postav, Hoova mála, vytažení lodě v Reghedu a záchrana Rauka a Austia ze zakharského zajetí.","key_places":["Dračí let","Pevnost Rudé rytířky","Knihovna Arenkae","Stříbroluní","Chrám Západního úsvitu","Ascore","Khôltar","Reghedský ledovec","Zakhara"],"key_enemies":["skřetí Horda","Axel Adamantis","Devrel","Sar Saratar","Genoaard a illithid Sheezo","yugolothi","admirál Hook","Drik Oranžový"],"img":"D_03","side":[{"key":"lovci","title":"Sigilští lovci","summary":"Vedlejší hra vznikla na podzim 2012 jako Planescape s novými postavami kolem dvou milionů zkušeností a se střídáním Pánů jeskyně. Pepa v ní hrál sigilského měňavce Tamise, Lukáš trpaslíka a později taurena Thora Thunderstrika, Vojta severského barbara a Zdeněk T. pixie Zaxe. Lovci prošli čtvrti Sigilu, Krynn i Ravenloft, honili zabijáky Gar'ratovy a Tamisova soka Toraxe. Od prosince 2016 pracovali pro Tethyrskou družinu: Tamis a Thor s ní šli do Shoonachu a od roku 2020 se z Lovců stala úderná jednotka, kterou na questy vypouštěl Rauko. V Turmishi ničili zázemí Temných, rozbili jim továrnu na konstrukty a přehradu DeepGate, takže Temní své stroje v Anaurochu nenasadili, a Tamis si odnesl Rudou dračí masku.","real":"2012–2023","dr":"1383–1385 DR"}],"chapters":[{"title":"Dračí let a knihovna Arenkae","sessions":["s-2011-12-26","s-2012-02-16","s-2012-03-10","s-2012-03-16","s-2012-04-07","s-2012-07-20","s-2012-07-27","s-2012-08-17"],"real":"2011–2012","drs":"1382–1383 DR","id":"ch-draci-let-a-knihovna-arenkae","words":588,"min":3,"route":[33,34,35,36],"cast":[["Ho","Pepa"],["Rauko","Lukáš"],["Varion","Zdeněk K."],["Austius","Vojta"],["Hypros","Lukáš"]],"gallery":[{"k":"foto/003","cap":"U stolu, 16.–17. 3. 201